        <default applyOnUpdate="0" expression="" field="id"/>
        <default applyOnUpdate="0" expression="" field="planid"/>
        <default applyOnUpdate="1" expression="rotateRoadSign( array(@snaplag), 0.1, &quot;retning&quot;)" field="rotation"/>
        <default applyOnUpdate="0" expression="right" field="retning"/>
        <default applyOnUpdate="0" expression="5" field="offset"/>
        <default applyOnUpdate="0" expression="False" field="dobbeltsidet"/>
        <default applyOnUpdate="0" expression="" field="type_forside"/>
